ARG UBUNTU_IMAGE
FROM ${UBUNTU_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash-completion build-essential ca-certificates curl fd-find file fzf git jq less \
      openssh-client procps ripgrep socat stow sudo unzip wget xz-utils \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd \
 && rm -rf /var/lib/apt/lists/*

COPY image/versions /opt/devenv/versions
COPY image/install-helpers.sh /opt/devenv/install-helpers.sh
COPY image/tools/ /opt/devenv/tools/

RUN --mount=type=cache,target=/var/cache/devenv /opt/devenv/tools/neovim.sh
RUN --mount=type=cache,target=/var/cache/devenv /opt/devenv/tools/tree-sitter.sh
RUN --mount=type=cache,target=/var/cache/devenv /opt/devenv/tools/node.sh
RUN --mount=type=cache,target=/var/cache/devenv /opt/devenv/tools/lazygit.sh
RUN --mount=type=cache,target=/var/cache/devenv /opt/devenv/tools/yazi.sh
RUN --mount=type=cache,target=/var/cache/devenv /opt/devenv/tools/zellij.sh
RUN --mount=type=cache,target=/var/cache/devenv /opt/devenv/tools/lsd.sh
RUN --mount=type=cache,target=/var/cache/devenv /opt/devenv/tools/claude-code.sh

ARG WITH_DOTNET=
RUN --mount=type=cache,target=/var/cache/devenv \
    if [ -n "$WITH_DOTNET" ]; then /opt/devenv/tools/dotnet.sh $WITH_DOTNET; fi

ARG WITH_JAVA=
RUN --mount=type=cache,target=/var/cache/devenv \
    if [ -n "$WITH_JAVA" ]; then /opt/devenv/tools/java.sh; fi

ARG WITH_GODOT=
RUN --mount=type=cache,target=/var/cache/devenv \
    if [ -n "$WITH_GODOT" ]; then /opt/devenv/tools/godot.sh "$WITH_GODOT"; fi

ARG WITH_PYTHON=
RUN if [ -n "$WITH_PYTHON" ]; then /opt/devenv/tools/python.sh; fi

ARG WITH_CONTAINER_ENGINE=
RUN --mount=type=cache,target=/var/cache/devenv \
    if [ -n "$WITH_CONTAINER_ENGINE" ]; then /opt/devenv/tools/container-engine.sh; fi

ARG USER_NAME=dev
ARG USER_UID=1000
ARG USER_GID=1000
RUN userdel --remove ubuntu 2>/dev/null || true \
 && existing_group=$(getent group "$USER_GID" | cut -d: -f1) \
 && if [ -n "$existing_group" ]; then groupmod --new-name "$USER_NAME" "$existing_group"; else groupadd --gid "$USER_GID" "$USER_NAME"; fi \
 && useradd --create-home --uid "$USER_UID" --gid "$USER_GID" --shell /bin/bash "$USER_NAME" \
 && echo "$USER_NAME ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/$USER_NAME" \
 && chmod 0440 "/etc/sudoers.d/$USER_NAME" \
 && mkdir -p "/home/$USER_NAME/Project" "/home/$USER_NAME/.cache" "/home/$USER_NAME/.host" \
 && chown -R "$USER_UID:$USER_GID" "/home/$USER_NAME"

ENV PATH=/opt/node/bin:/opt/java/bin:/opt/dotnet:/home/${USER_NAME}/.dotnet/tools:${PATH} \
    DOTNET_ROOT=/opt/dotnet \
    JAVA_HOME=/opt/java \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DISABLE_AUTOUPDATER=1 \
    NUGET_PACKAGES=/home/${USER_NAME}/.cache/nuget \
    npm_config_cache=/home/${USER_NAME}/.cache/npm \
    NODE_OPTIONS=--dns-result-order=ipv4first \
    SSH_AUTH_SOCK=/tmp/devenv/ssh-agent.sock

COPY container/entrypoint.sh /opt/devenv/entrypoint.sh

USER ${USER_NAME}
WORKDIR /home/${USER_NAME}/Project
CMD ["/opt/devenv/entrypoint.sh"]
