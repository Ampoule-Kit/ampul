#!/usr/bin/env bash
set -euo pipefail

resolve_devenv_dir() {
  local script=$0 script_dir
  while [ -L "$script" ]; do
    script_dir=$(cd -P "$(dirname "$script")" && pwd)
    script=$(readlink "$script")
    case "$script" in /*) ;; *) script=$script_dir/$script ;; esac
  done
  cd -P "$(dirname "$script")" && pwd
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

DEVENV_DIR=$(resolve_devenv_dir)
. "$DEVENV_DIR/devenv.conf"
. "$DEVENV_DIR/image/versions"

PROJECTS_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/devenv/projects
CONTAINER_HOME=/home/$CONTAINER_USER
CONTAINER_PROJECT_DIR=$CONTAINER_HOME/Project
CACHE_VOLUME=devenv-cache
PROJECT_LABEL=devenv.project
CACHE_LABEL=devenv.cache
ENGINE_SOCKET=/run/podman/podman.sock
FORWARDED_PORTS_START=61000

. "$DEVENV_DIR/cli/engine.sh"
. "$DEVENV_DIR/cli/projects.sh"
. "$DEVENV_DIR/cli/prompts.sh"
. "$DEVENV_DIR/cli/containers.sh"
. "$DEVENV_DIR/cli/project-code.sh"
. "$DEVENV_DIR/cli/commands.sh"

command=${1:-help}
shift || true
case "$command" in
  new) command_new "$@" ;;
  enter) command_enter "$@" ;;
  start) command_start "$@" ;;
  stop) command_stop "$@" ;;
  rebuild) command_rebuild "$@" ;;
  setup) command_setup "$@" ;;
  config) command_config "$@" ;;
  rm) command_rm "$@" ;;
  ls) command_ls ;;
  purge) command_purge "$@" ;;
  help | -h | --help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
