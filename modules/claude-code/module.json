{
  "label": "Claude Code",
  "description": "Anthropic's coding agent for the terminal. Start it with claude.",
  "version": "2.1.332",
  "latestVersion": {
    "url": "https://downloads.claude.ai/claude-code-releases/latest",
    "match": "^([0-9]+\\.[0-9]+\\.[0-9]+)"
  },
  "selectedByDefault": true,
  "downloads": [
    {
      "url": "https://downloads.claude.ai/claude-code-releases/{version}/linux-{arch}/claude",
      "architectures": {
        "arm64": "arm64",
        "amd64": "x64"
      },
      "sha256": {
        "arm64": "50c305fcb8912851ce774429131d94ed6f84edbe3d8d0ed7a59dade5d893acc0",
        "amd64": "a2df1f41bb00250992926420d0063f89b127cb81abdd284dbefb80c50ff1d026"
      },
      "installTo": "/opt/claude-code",
      "fileName": "claude",
      "commands": [
        "claude"
      ]
    }
  ],
  "environment": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "check": "claude --version"
}
