      },
      "sha256": {
        "arm64": "14590f644805a6234ffe071154340669e38137f38e60aa9629690119704107d2",
        "amd64": "bf65ac1a0af10f92c522d91ac096c7c0a39657647b155577e7836c2cbbb4526c"
      },
      "installTo": "/opt/uv",
      "commands": [
        "uv",
        "uvx"
      ]
    }
  ],
  "check": "uv --version && uvx --version"
}
