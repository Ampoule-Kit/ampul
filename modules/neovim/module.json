{
  "label": "Neovim",
  "description": "The Neovim editor with NvChad, language servers for TypeScript, ESLint and C#, formatters and treesitter parsers, all from this repo's config.",
  "version": "0.12.6",
  "selectedByDefault": true,
  "requires": [
    "node",
    "tree-sitter",
    "ripgrep",
    "fd",
    "build-essential"
  ],
  "downloads": [
    {
      "url": "https://github.com/neovim/neovim/releases/download/v{version}/nvim-linux-{arch}.tar.gz",
      "architectures": {
        "arm64": "arm64",
        "amd64": "x86_64"
      },
      "sha256": {
        "arm64": "8f1f64a0bdb97247034038c3823c6cbad5bdf9ecd5751b85494b71c3ee04c815",
        "amd64": "474430d53e6264f6d6dd18db42d6dc9df3a1b56ca9e88a325bbf860e1a811d87"
      },
      "installTo": "/opt/neovim",
      "commands": [
        "bin/nvim"
      ]
    }
  ],
  "check": "nvim --version"
}
