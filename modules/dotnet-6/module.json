{
  "label": ".NET 6 SDK",
  "description": "The .NET SDK, installed side by side with any other .NET SDK you pick, with NuGet packages cached across rebuilds.",
  "version": "6.0.428",
  "latestVersion": {
    "url": "https://builds.dotnet.microsoft.com/dotnet/release-metadata/6.0/releases.json",
    "match": "\"latest-sdk\":\\s*\"([^\"]+)\""
  },
  "selectedByDefault": false,
  "packages": [
    "libicu74"
  ],
  "downloads": [
    {
      "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/{version}/dotnet-sdk-{version}-linux-{arch}.tar.gz",
      "architectures": {
        "arm64": "arm64",
        "amd64": "x64"
      },
      "sha512": {
        "arm64": "cb8454865ecb99ce557bd0a5741d3dc84657a45ea00f9b2a0f0593e94e4e661e898a5690df90cf0175bf5982973c19985a168998aaa975b7ac7a3bef2ecd05d2",
        "amd64": "04395f991ab50e4755ce1ae53e23592a7420b71b82160883bae3194dd1dfd5dcaed78743e4e0b4dd51ea43c49ec84b5643630707b3854f1471265dc98490d2f9"
      },
      "installTo": "/opt/dotnet",
      "sharedFolder": true
    }
  ],
  "environment": {
    "DOTNET_ROOT": "/opt/dotnet",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NUGET_PACKAGES": "{home}/.cache/nuget",
    "ASPNETCORE_ENVIRONMENT": "Development"
  },
  "path": [
    "/opt/dotnet",
    "{home}/.dotnet/tools"
  ],
  "portPresets": [
    {
      "id": "aspnet",
      "label": "ASP.NET Core",
      "port": 5000,
      "lastPort": 5001,
      "section": "Web apps",
      "description": "Kestrel’s defaults: HTTP on 5000 and HTTPS on 5001. Projects made with dotnet new pick their own ports in Properties/launchSettings.json."
    },
    {
      "id": "aspire-dashboard",
      "label": ".NET Aspire dashboard",
      "port": 18888,
      "lastPort": 18890,
      "section": "Web apps",
      "description": "The Aspire dashboard on 18888, and its OpenTelemetry endpoints on 18889 (gRPC) and 18890 (HTTP). An AppHost made with dotnet new picks its own dashboard port in Properties/launchSettings.json; add that one under other ports."
    }
  ],
  "legacySettings": [
    {
      "setting": "DOTNET_SDKS",
      "value": "6"
    }
  ],
  "check": "dotnet --list-sdks"
}
