        "amd64": "bd423c61517dbbda74bddebb8c1c1b1609f156ea13738349f6e95d0289f17bc4"
      },
      "installTo": "/opt/azure-cli",
      "fileName": "azure-cli.deb"
    }
  ],
  "environment": {
    "AZURE_CORE_COLLECT_TELEMETRY": "false"
  },
  "latestVersion": {
    "url": "https://packages.microsoft.com/repos/azure-cli/dists/resolute/main/binary-amd64/Packages",
    "match": "azure-cli_([0-9]+\\.[0-9]+\\.[0-9]+)-1~resolute_amd64\\.deb"
