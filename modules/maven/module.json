        "amd64": "57d2db6b37e7582119137ade544557bba741b29e62109ef81539a2bdfd6d0e641fdd5d8edb014af1816d0510deac6fac8f347433b3a1aa36316ba85aa77b8119"
      },
      "installTo": "/opt/maven"
    }
  ],
  "path": [
    "/opt/maven/bin"
  ],
  "latestVersion": {
    "url": "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/maven-metadata.xml",
    "match": "<version>(3\\.[0-9]+\\.[0-9]+)</version>"
  },
  "check": "mvn --version"
}
