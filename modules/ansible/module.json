{
  "label": "Ansible",
  "description": "Ansible with its community collections, the ansible and ansible-playbook commands. It runs on its own Python, installed by uv, which is selected with it.",
  "version": "15.0.0",
  "selectedByDefault": false,
  "requires": [
    "uv"
  ],
  "downloads": [
    {
      "url": "https://files.pythonhosted.org/packages/py3/a/ansible/ansible-{version}-py3-none-any.whl",
      "architectures": {
        "arm64": "any",
        "amd64": "any"
      },
      "sha256": {
        "arm64": "c15fa794d926523f0794625ccc4021fe5d799eed1fd60be110e20922fc9086e1",
        "amd64": "c15fa794d926523f0794625ccc4021fe5d799eed1fd60be110e20922fc9086e1"
      },
      "installTo": "/opt/ansible-wheels",
      "sharedFolder": true,
      "fileName": "ansible.whl"
    },
    {
      "name": "core",
      "version": "2.22.0",
      "url": "https://files.pythonhosted.org/packages/py3/a/ansible-core/ansible_core-{version}-py3-none-any.whl",
      "architectures": {
        "arm64": "any",
        "amd64": "any"
      },
      "sha256": {
        "arm64": "8285d4cc81c3e3eb2d954e75531724fe0ae154d228475638123451f034a74657",
        "amd64": "8285d4cc81c3e3eb2d954e75531724fe0ae154d228475638123451f034a74657"
      },
      "installTo": "/opt/ansible-wheels",
      "sharedFolder": true,
      "fileName": "ansible-core.whl",
      "latestVersion": {
        "url": "https://pypi.org/pypi/ansible-core/json",
        "match": "\"version\":\\s*\"([0-9]+\\.[0-9]+\\.[0-9]+)\""
      }
    }
  ],
  "latestVersion": {
    "url": "https://pypi.org/pypi/ansible/json",
    "match": "\"version\":\\s*\"([0-9]+\\.[0-9]+\\.[0-9]+)\""
  },
  "check": "ansible --version && ansible-playbook --version && ansible-galaxy collection list community.general"
}
