{
  "label": "Terraform",
  "description": "HashiCorp's infrastructure as code tool, the terraform command.",
  "version": "1.17.2",
  "selectedByDefault": false,
  "downloads": [
    {
      "url": "https://releases.hashicorp.com/terraform/{version}/terraform_{version}_linux_{arch}.zip",
      "architectures": {
        "arm64": "arm64",
        "amd64": "amd64"
      },
      "sha256": {
        "arm64": "858e08c181a76b6b223e8c767a8e983922eebe2d062db949a2de66ce040c368c",
        "amd64": "e6f16b2f0b137ee5729caa8c4e79a3bae4ee261acd198a1fcfa8584a6296605b"
      },
      "installTo": "/opt/terraform",
      "commands": [
        "terraform"
      ]
    }
  ],
  "environment": {
    "CHECKPOINT_DISABLE": "1"
  },
  "latestVersion": {
    "url": "https://checkpoint-api.hashicorp.com/v1/check/terraform",
    "match": "\"current_version\":\"([0-9]+\\.[0-9]+\\.[0-9]+)\""
  },
  "check": "terraform version"
}
