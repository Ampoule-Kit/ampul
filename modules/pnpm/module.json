{
  "label": "pnpm",
  "description": "The pnpm package manager for Node.js projects, which is selected with it. Global packages go in ~/.local/share/pnpm.",
  "version": "12.23.0",
  "selectedByDefault": false,
  "requires": [
    "node"
  ],
  "downloads": [
    {
      "url": "https://github.com/pnpm/pnpm/releases/download/v{version}/pnpm-linux-{arch}.tar.gz",
      "architectures": {
        "arm64": "arm64",
        "amd64": "x64"
      },
      "sha256": {
        "arm64": "dd03f7616625ff8f13d952f641f0864a2300d73d0a751a682737615bd9f9a7a2",
        "amd64": "b515e29f2ac1adc0fbe63173414a6682827baff24f17e7ad3476821bdef236ac"
      },
      "installTo": "/opt/pnpm",
      "commands": [
        "pnpm"
      ]
    }
  ],
  "environment": {
    "PNPM_HOME": "{home}/.local/share/pnpm"
  },
  "path": [
    "{home}/.local/share/pnpm"
  ],
  "check": "pnpm --version"
}
